# Copy this file to .env and fill in real values. Never commit .env.
# ENVIRONMENT: local | cloud
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Postgres (C9 App Datastore) ---
# Docker locally -> AWS RDS Free-tier Postgres in the cloud (same env var names, different values).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fraud_detection
POSTGRES_USER=fraud_app
POSTGRES_PASSWORD=change-me

# --- Neo4j (C4 Graph Store) ---
# Docker Community locally -> AuraDB Free in the cloud.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-min-8-chars

# --- Redpanda (C2 Stream Broker) ---
# Kafka-API-compatible; swap the bootstrap servers for Kinesis config when moving to the cloud.
# 19092 is Redpanda's external (host-reachable) listener; 9092 is for other containers on the compose network.
REDPANDA_BOOTSTRAP_SERVERS=localhost:19092
TRANSACTIONS_TOPIC=transactions

# --- Scoring API (C8) ---
API_HOST=0.0.0.0
API_PORT=8000
# Static service-to-service key: producer/consumer -> scoring API (SAD auth model).
SERVICE_API_KEY=change-me

# --- Auth (dashboard-facing JWT) ---
JWT_SECRET_KEY=change-me-use-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Dashboard (C10) ---
DASHBOARD_PORT=8501
SCORING_API_BASE_URL=http://localhost:8000

# --- Model / embedding versions (never "latest" in serving) ---
MODEL_VERSION=
EMBEDDING_VERSION=

# --- MLOps (C11) ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- AWS (Part 3 of the execution guide — not needed for local Docker Compose dev) ---
# Populate only after billing guardrails (budget + alarm) are in place.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ARTIFACTS_BUCKET=
KINESIS_STREAM_NAME=
