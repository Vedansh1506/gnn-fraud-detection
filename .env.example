# Copy this file to .env and fill in real values. Never commit .env.
# ENVIRONMENT: local | cloud
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Postgres (C9 App Datastore) ---
# Docker locally -> AWS RDS Free-tier Postgres in the cloud (same env var names, different values).
POSTGRES_HOST=localhost
# 5433, not 5432: a locally-installed PostgreSQL commonly already owns 5432,
# and Docker silently fails to publish the port rather than erroring.
POSTGRES_PORT=5433
POSTGRES_DB=fraud_detection
POSTGRES_USER=fraud_app
POSTGRES_PASSWORD=change-me

# --- Neo4j (C4 Graph Store) ---
# Docker Community locally -> AuraDB Free in the cloud.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-min-8-chars

# --- Redpanda (C2 Stream Broker) ---
# Kafka-API-compatible; swap the bootstrap servers for Kinesis config when moving to the cloud.
# 19092 is Redpanda's external (host-reachable) listener; 9092 is for other containers on the compose network.
REDPANDA_BOOTSTRAP_SERVERS=localhost:19092
TRANSACTIONS_TOPIC=transactions

# --- Scoring API (C8) ---
API_HOST=0.0.0.0
API_PORT=8000
# Static service-to-service key: producer/consumer -> scoring API (SAD auth model).
SERVICE_API_KEY=change-me

# --- Auth (dashboard-facing JWT) ---
# Dashboard users are rows in the `users` table, not env vars - create them with:
#   uv run python -m src.db.seed_users --username analyst --role analyst
#   uv run python -m src.db.seed_users --username ops --role operator
# (the password is prompted for, or read from SEED_PASSWORD; only the bcrypt
# hash is stored). Generate a real JWT_SECRET_KEY before any deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-use-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Dashboard (C10 - React SPA, replaced Streamlit 2026-09-13) ---
# Host port the built dashboard is served on by the compose `frontend` service.
# Vite's own dev server (`npm run dev` in frontend/) is fixed at 5173.
DASHBOARD_PORT=5173
SCORING_API_BASE_URL=http://localhost:8000
# Baked into the bundle at build time - this is the API URL as the *browser*
# resolves it, not a compose service name.
VITE_API_BASE_URL=http://localhost:8000
# Origins allowed to call the API from a browser. Comma-separated and explicit:
# 5173 is the Vite dev server, 4173 `vite preview`. Never a wildcard - the API
# sends credentials, so any origin here can act as a signed-in analyst.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Model / embedding versions (never "latest" in serving) ---
MODEL_VERSION=gnn_v2
EMBEDDING_VERSION=gnn_emb_v2

# --- MLOps (C11) ---
# Host port 5500, not MLflow's usual 5000: 5000 is commonly reserved on Windows
# (bind fails with WinError 10013) and Docker publishes it without erroring, so
# the container looks healthy while nothing on the host can reach it.
MLFLOW_PORT=5500
MLFLOW_TRACKING_URI=http://localhost:5500
MLFLOW_EXPERIMENT=fraud-detection

# --- AWS (Part 3 of the execution guide — not needed for local Docker Compose dev) ---
# Populate only after billing guardrails (budget + alarm) are in place.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ARTIFACTS_BUCKET=
KINESIS_STREAM_NAME=
